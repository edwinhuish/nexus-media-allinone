#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# =============================================================================
#  nexus-media 后端服务（Granian / FastAPI）
#  相对上游的两处改动：
#    1. 应用显式绑定 NEXUS_HOST（默认 127.0.0.1），容器外不可达；
#    2. NEXUS_PORT 同时决定应用监听端口与 Nginx upstream 端口。
#    环境变量优先级高于 /data/config.yaml，不会与其冲突。
# =============================================================================

umask ${UMASK}

export APP__WEB_PORT="${NEXUS_PORT:-3000}"
export APP__WEB_HOST="${NEXUS_HOST:-127.0.0.1}"

# 数据库迁移（幂等）；compose 中由 migration 服务负责时可设 SKIP_MIGRATION=true
if [ "${SKIP_MIGRATION:-false}" != "true" ]; then
    bash -c "cd ${WORKDIR} && .venv/bin/alembic upgrade head"
fi

# 探测用 127.0.0.1 而非 localhost：应用只绑 IPv4 回环，避免 localhost 先解析到 ::1
# 导致探测失败、依赖本服务的 nginx 永远不启动。
exec \
    s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z 127.0.0.1 ${NEXUS_PORT:-3000}" \
    s6-setuidgid nexus bash -c 'cd "${WORKDIR}" && exec sh ./start-prod.sh'

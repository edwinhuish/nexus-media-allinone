# =============================================================================
#  Nexus Media All-in-One — 唯一对外入口 Nginx
#
#    :8080 ──┬── /                       前端 SPA（/usr/share/nginx/html）
#            ├── /api/ /img/ /ws         反向代理 → http://127.0.0.1:__NEXUS_PORT__
#            ├── /health /docs /openapi.json
#            └── /static/ /assets/       前端产物优先，未命中回落后端同名路径
#
#  __NEXUS_PORT__ 由 /etc/cont-init.d/021-nginx-port 启动时渲染为 $NEXUS_PORT。
#  本文件由上游后端 / 前端两个 nginx.conf.template 合并而来，
#  冲突项取舍见 README「配置合并时的取舍」。
# =============================================================================

user nexus;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
# 上游用 /var/run/nginx.pid（默认仅 root 可写）；改用独立目录，由 030-nginx-runtime-perms 预置属主
pid /run/nginx/nginx.pid;

events {
    worker_connections 1024;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # 上游 mime.types 不含 mjs，而 Vben 前端产物里有 .mjs
    types {
        application/javascript mjs;
    }

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    server_tokens off;

    # 媒体库上传体积上限
    client_max_body_size 500M;

    # 临时目录必须显式指定并保证 nexus 可写，否则大文件上传会 500
    client_body_temp_path /var/lib/nginx/body;
    proxy_temp_path       /var/lib/nginx/proxy;
    fastcgi_temp_path     /var/lib/nginx/fastcgi;
    uwsgi_temp_path       /var/lib/nginx/uwsgi;
    scgi_temp_path        /var/lib/nginx/scgi;

    # ---- 压缩 ----
    gzip on;
    gzip_buffers 32 16k;
    gzip_comp_level 6;
    gzip_min_length 1k;
    gzip_types text/plain
               text/css
               application/javascript
               application/json
               application/x-javascript
               text/xml
               application/xml
               application/xml+rss
               text/javascript;
    gzip_vary on;
    # 前端产物含预压缩 .gz 时直接命中；未命中自动回退原文件
    gzip_static on;

    # ---- 后端上游：只在容器内回环可达 ----
    upstream nexus_backend {
        server 127.0.0.1:__NEXUS_PORT__;
        keepalive 32;
    }

    server {
        listen 8080 default_server;
        listen [::]:8080 default_server;
        server_name _;
        merge_slashes off;

        root /usr/share/nginx/html;
        index index.html;

        # ---- 后端不可用：返回 JSON，前端可直接读取 message 做提示 ----
        error_page 502 503 504 /__backend_unavailable__;
        location = /__backend_unavailable__ {
            internal;
            default_type application/json;
            add_header Access-Control-Allow-Origin  "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers "*" always;
            return 503 '{"code":-1,"message":"服务正在启动中，请稍后刷新..."}';
        }

        # ================= 后端 API（反代到 127.0.0.1:__NEXUS_PORT__）=================

        location /api/ {
            proxy_pass http://nexus_backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # 配合 upstream keepalive 复用长连接
            proxy_set_header Connection        "";
            proxy_buffering off;
            proxy_connect_timeout 300s;
            proxy_send_timeout    300s;
            proxy_read_timeout    300s;
        }

        # 图片反代接口（后端代取外部图床）
        location = /img {
            proxy_pass http://nexus_backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_send_timeout    60s;
            proxy_read_timeout    60s;
        }

        location /img/ {
            proxy_pass http://nexus_backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_send_timeout    60s;
            proxy_read_timeout    60s;
        }

        location = /health {
            proxy_pass http://nexus_backend;
            proxy_http_version 1.1;
            proxy_set_header Host       $host;
            proxy_set_header Connection "";
            access_log off;
        }

        location = /openapi.json {
            proxy_pass http://nexus_backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /docs {
            proxy_pass http://nexus_backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # WebSocket（实时日志 / 任务进度）
        location /ws {
            proxy_pass http://nexus_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host       $host;
            proxy_set_header X-Real-IP  $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # ================= 前端静态产物 =================

        location ^~ /assets/ {
            root /usr/share/nginx/html;
            try_files $uri =404;
            access_log off;
            expires 30d;
            add_header Cache-Control "public, max-age=2592000, immutable";
        }

        # /static/ 两边都有：前端产物优先，未命中回落后端
        location ^~ /static/ {
            root /usr/share/nginx/html;
            try_files $uri @backend_static;
            access_log off;
            expires 30d;
            add_header Cache-Control "public, max-age=2592000, immutable";
        }

        location = /sw.js {
            root /usr/share/nginx/html;
            try_files $uri =404;
            access_log off;
            add_header Cache-Control "no-cache";
        }

        location = /manifest.webmanifest {
            root /usr/share/nginx/html;
            try_files $uri =404;
            access_log off;
        }

        location = /favicon.ico {
            root /usr/share/nginx/html;
            try_files $uri =404;
            access_log off;
        }

        # SPA 入口不做长缓存，避免发版后仍命中旧 index.html
        location = /index.html {
            add_header Cache-Control "no-store, must-revalidate";
        }

        # ---- 兜底：前端 SPA 路由 ----
        location / {
            try_files $uri $uri/ /index.html;
        }

        # ---- 后端 /static/ 回落（仅在上一级 try_files 未命中时进入）----
        location @backend_static {
            proxy_pass http://nexus_backend;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }
}

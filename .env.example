# 复制为 .env 后按需修改：cp .env.example .env

# ---- 运行用户：填宿主机 `id -u` / `id -g`，容器内文件即与宿主机同属主 ----
PUID=1000
PGID=1000
UMASK=000

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 唯一对外端口（宿主机端口 → 容器内 Nginx 8080）----
WEB_PORT=8080

# ---- 媒体库目录（宿主机路径）----
VIDEO_DIR=/video

# ---- 数据库（docker-compose.mysql.yml / docker-compose.postgresql.yml 必填密码）----
DB_TYPE=postgresql # sqlite | mysql | postgresql
DB_HOST=postgresql # mysql / postgresql，对应 compose 内的服务名
DB_PORT=5432
DB_USERNAME=nexus_media
DB_PASSWORD=
DB_DATABASE=nexus_media
# 仅 MySQL 变体需要
MYSQL_ROOT_PASSWORD=

# ---- 缓存（redis 为 compose 内服务名）----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---- Chrome 自动化变体（docker-compose.mysql.yml / .postgresql.yml）----
VNC_PASSWORD=
# 留空则不启用登录鉴权
AUTH_PASSWORD=

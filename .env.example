# 复制为 .env 后按需修改：cp .env.example .env

# ---- 运行用户：填宿主机 `id -u` / `id -g`，容器内文件即与宿主机同属主 ----
PUID=1000
PGID=1000
UMASK=000

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- 唯一对外端口（宿主机端口 → 容器内 Nginx 8080）----
WEB_PORT=8080

# ---- 媒体库目录（宿主机路径）----
VIDEO_DIR=/video

# ---- 数据库 ----
DB_TYPE=postgresql # sqlite | mysql | postgresql
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=nexus
DB_PASSWORD=H5wMzWv3n8Z0bq
DB_DATABASE=nexus

# ---- 缓存 ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0